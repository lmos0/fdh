PORT=3000
LOG_LEVEL=info
ENABLE_BOT_TEST_MODE=false
# Use true para mostrar "Testar com 2 bots" e permitir salas individuais.
# A flag é lida ao iniciar o backend; reinicie após alterar.
# Para investigar problemas no backend: LOG_LEVEL=debug
# Níveis: debug, info, warn, error, silent.
# Em produção, configure a origem HTTPS pública, sem barra final.
# PUBLIC_ORIGIN=https://seu-jogo.onrender.com
# Opcional: Postgres para as métricas de cartas mais trocadas.
# Ausente, a coleta fica desligada. Veja "Métricas de cartas" no README.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
